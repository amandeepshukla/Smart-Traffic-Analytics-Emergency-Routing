# Copy to .env (or set as real environment variables on your host)

# Detector: auto (YOLO for real video if installed, else OpenCV) | yolo | motion
DETECTOR=auto
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35

# Processing size / rate per camera — lower these on small free-tier servers
FRAME_WIDTH=480
FRAME_HEIGHT=270
CAMERA_FPS=8
LANES=3

# Calibration: vehicles visible = 100% congestion
CAPACITY=10

# Comma-separated list of allowed frontend origins ("*" = any)
CORS_ORIGINS=*

# Restrict to a few cameras to save CPU (empty = all 12), e.g. J1,J2,J5,H1
CAMERA_NODES=

# Expose demo endpoints (force a jam, take a camera offline)
ENABLE_SIMULATION_API=true
